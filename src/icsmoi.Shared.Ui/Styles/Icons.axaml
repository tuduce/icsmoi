<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    icsmoi icon set — monochrome, thin-stroke, round-capped line icons drawn on a
    24x24 grid (2px safe margin). Geometries are stroke-only paths: the stroke takes
    the *inherited Foreground*, so an icon inside a Button automatically follows the
    button's normal/hover/pressed/disabled foreground (see the ButtonForeground*
    overrides in Tokens.axaml) with no per-state styling.

    Usage (inside any Button):
      <ContentControl Theme="{StaticResource Icsmoi.Icon}"      Content="{StaticResource Icsmoi.Icon.Play}" />
      <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Play}" />
    Icon = bare 16px glyph (for icon-only round buttons). BadgeIcon = the glyph inside a
    26px circle that sits in the pill's rounded end — pair it with Button.iconed so the
    badge is concentric with the pill (see Controls.axaml).

    The Canvas is fixed at 24x24 inside a Viewbox on purpose: a bare Path with
    Stretch="Uniform" would rescale each icon to its own bounds, making small glyphs
    look bigger than large ones.
  -->

  <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
  <!-- Navigation arrow (aviation heading marker) -->
  <StreamGeometry x:Key="Icsmoi.Icon.Connect">M3.5 10.5 L20.5 3.5 L13.5 20.5 L11 13 Z M11 13 L20.5 3.5</StreamGeometry>
  <!-- Power symbol -->
  <StreamGeometry x:Key="Icsmoi.Icon.Disconnect">M12 3.5 V11 M6.6 6.6 A7.5 7.5 0 1 0 17.4 6.6</StreamGeometry>
  <StreamGeometry x:Key="Icsmoi.Icon.Play">M8 5.5 L18.5 12 L8 18.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icsmoi.Icon.Stop">M7 7 H17 V17 H7 Z</StreamGeometry>
  <!-- Arrow down into a tray -->
  <StreamGeometry x:Key="Icsmoi.Icon.Save">M12 4 V14.5 M7.5 10.5 L12 15 L16.5 10.5 M4.5 15.5 V19 H19.5 V15.5</StreamGeometry>
  <!-- Pencil -->
  <StreamGeometry x:Key="Icsmoi.Icon.Edit">M15.5 5 A2.1 2.1 0 0 1 19 8.5 L8.5 19 L4 20 L5 15.5 Z M13 7.5 L16.5 11</StreamGeometry>
  <!-- Check mark -->
  <StreamGeometry x:Key="Icsmoi.Icon.Check">M5 12.5 L10 17.5 L19 7</StreamGeometry>
  <!-- Folder -->
  <StreamGeometry x:Key="Icsmoi.Icon.Open">M3.5 7 A1.5 1.5 0 0 1 5 5.5 H9.5 L11.5 7.5 H19 A1.5 1.5 0 0 1 20.5 9 V17.5 A1.5 1.5 0 0 1 19 19 H5 A1.5 1.5 0 0 1 3.5 17.5 Z</StreamGeometry>

  <!-- ── Node palette: Input ──────────────────────────────────────────────── -->
  <!-- Broadcast: dot + two pairs of arcs -->
  <StreamGeometry x:Key="Icsmoi.Icon.SimConnect">M10.5 12 A1.5 1.5 0 1 1 13.5 12 A1.5 1.5 0 1 1 10.5 12 Z M7.8 7.8 A6 6 0 0 0 7.8 16.2 M16.2 7.8 A6 6 0 0 1 16.2 16.2 M5 5 A10 10 0 0 0 5 19 M19 5 A10 10 0 0 1 19 19</StreamGeometry>

  <!-- ── Node palette: Logic & Math ───────────────────────────────────────── -->
  <StreamGeometry x:Key="Icsmoi.Icon.Math">M17.5 5.5 H6.5 L12.5 12 L6.5 18.5 H17.5</StreamGeometry>
  <!-- Greater-or-equal -->
  <StreamGeometry x:Key="Icsmoi.Icon.Compare">M7 5.5 L17 10.5 L7 15.5 M7 19.5 H17</StreamGeometry>
  <!-- Logic gate (D-shape, two inputs, one output) -->
  <StreamGeometry x:Key="Icsmoi.Icon.Logic">M6 5 H12 A7 7 0 0 1 12 19 H6 Z M2.5 9 H6 M2.5 15 H6 M19 12 H21.5</StreamGeometry>
  <!-- Fork: one input, two branches -->
  <StreamGeometry x:Key="Icsmoi.Icon.Select">M3.5 12 H10 M10 12 L15.5 6.5 H20.5 M10 12 L15.5 17.5 H20.5</StreamGeometry>

  <!-- ── Node palette: Shaping ────────────────────────────────────────────── -->
  <!-- Two limits with a value held between them -->
  <StreamGeometry x:Key="Icsmoi.Icon.Clamp">M5 4.5 V19.5 M19 4.5 V19.5 M5 12 H10 M14 12 H19 M10 12 A2 2 0 1 1 14 12 A2 2 0 1 1 10 12 Z</StreamGeometry>
  <!-- Narrow range widening into a wide one (funnel) -->
  <StreamGeometry x:Key="Icsmoi.Icon.RangeMap">M8 6 H16 L21 18 H3 Z</StreamGeometry>
  <!-- Axes + smooth S-curve -->
  <StreamGeometry x:Key="Icsmoi.Icon.Curve">M4 4 V20 H20 M7 17 C11 17 11 8 15 8 S18 7 19 6</StreamGeometry>

  <!-- ── Node palette: Hardware output ────────────────────────────────────── -->
  <!-- Straight force arrow -->
  <StreamGeometry x:Key="Icsmoi.Icon.ConstantForce">M4 12 H19 M13.5 6.5 L19.5 12 L13.5 17.5</StreamGeometry>
  <!-- Spring / coil -->
  <StreamGeometry x:Key="Icsmoi.Icon.Condition">M3 12 H6 L8 6 L12 18 L16 6 L18 12 H21</StreamGeometry>
  <!-- Sine wave -->
  <StreamGeometry x:Key="Icsmoi.Icon.Periodic">M3 12 C5 5 9 5 12 12 C15 19 19 19 21 12</StreamGeometry>
  <!-- Ramp -->
  <StreamGeometry x:Key="Icsmoi.Icon.RampForce">M4 19 H20 V6 Z</StreamGeometry>

  <!-- ── Icon controls ────────────────────────────────────────────────────── -->

  <ControlTheme x:Key="Icsmoi.Icon" TargetType="ContentControl">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox>
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Content}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.75"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="Icsmoi.BadgeIcon" TargetType="ContentControl">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Icsmoi.IconBadge}"
                CornerRadius="{DynamicResource Icsmoi.PillRadius}">
          <Viewbox Width="16" Height="16">
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Content}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="1.75"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
