<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Shared control styles for icsmoi.Editor and icsmoi.Runtime (no NodifyM
    types here — Runtime must never reference the node canvas). Include after
    <FluentTheme /> in each App.axaml.

    Button: pill shape (half-round sides). Fluent's Button template binds its
    ContentPresenter to CornerRadius, so a large radius clamps to a stadium
    shape at any height. Only exact Button is matched — RepeatButton/ToggleButton
    (used inside ComboBox, NumericUpDown, ToggleSwitch) keep their own shapes.
    Colors come from the ButtonBackground*/ButtonForeground*/ButtonBorderBrush*
    resource keys overridden in Tokens.axaml.
  -->

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource Icsmoi.PillRadius}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Icon buttons (see Icons.axaml).
       iconed: labeled pill whose first child is a BadgeIcon. The tight left padding makes the
               26px badge concentric with the pill's rounded end:
               badge center x = 1 (border) + 4 (padding) + 13 = 18 = half the 36px button height.
       round:  icon-only circle (36x36) holding a bare Icon. -->
  <Style Selector="Button.iconed">
    <Setter Property="Padding" Value="4,4,16,4" />
  </Style>

  <Style Selector="Button.round">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- compact: small borderless round icon button for inline actions beside text (e.g. edit
       next to the profile name). Transparent until hovered — Fluent's :pointerover styling
       (accent fill) still applies because it targets the template's ContentPresenter. -->
  <Style Selector="Button.round.compact">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- State tints for round toggle buttons whose icon already flips with the state (e.g. the
       Editor's sim/engine buttons): on = running/connected, pending = requested but not there
       yet. Dark glyph on the fill, like the hover state, for contrast. -->
  <Style Selector="Button.round.on">
    <Setter Property="Background" Value="{DynamicResource Icsmoi.Success}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Icsmoi.Success}" />
    <Setter Property="Foreground" Value="{DynamicResource Icsmoi.Background}" />
  </Style>
  <Style Selector="Button.round.pending">
    <Setter Property="Background" Value="{DynamicResource Icsmoi.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Icsmoi.Warning}" />
    <Setter Property="Foreground" Value="{DynamicResource Icsmoi.Background}" />
  </Style>

</Styles>
