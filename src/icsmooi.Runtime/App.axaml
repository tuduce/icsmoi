<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="icsmooi.Runtime.App"
             RequestedThemeVariant="Dark">
             <!-- icsmooi always uses its own dark graphite/afterburner palette — see icsmooi.Shared.Ui/Styles/Tokens.axaml — rather than following the OS theme. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://icsmooi.Shared.Ui/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://icsmooi.Shared.Ui/Styles/Controls.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico" ToolTipText="icsmooi Runtime">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show status" Click="OnShowStatusClicked" />
                        <NativeMenuItem Header="Exit" Click="OnExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
