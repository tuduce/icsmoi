<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:icsmooi.Runtime.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="420" d:DesignHeight="340"
        x:Class="icsmooi.Runtime.Views.StatusWindow"
        x:DataType="vm:StatusWindowViewModel"
        Icon="avares://icsmooi.Shared.Ui/Assets/icsmooi.ico"
        Title="icsmooi Runtime"
        Width="420" Height="340"
        CanResize="False"
        Background="{DynamicResource Icsmooi.Background}">

    <StackPanel Margin="20" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ContentControl Theme="{StaticResource Icsmooi.Wordmark}" Height="30" VerticalAlignment="Bottom" />
            <TextBlock Text="Runtime" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2"
                       Foreground="{DynamicResource Icsmooi.TextMuted}" />
        </StackPanel>
        <TextBlock Text="Background telemetry + force-feedback engine."
                    Foreground="{DynamicResource Icsmooi.TextMuted}" TextWrapping="Wrap" />

        <Border Background="{DynamicResource Icsmooi.Surface}" CornerRadius="{DynamicResource Icsmooi.NodeRadius}" Padding="14" Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <DockPanel>
                    <Button Classes="iconed" DockPanel.Dock="Right" Click="OnLoadProfileClicked"
                            ToolTip.Tip="Load a saved .icsmooi.json profile">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Open}" />
                            <TextBlock Text="Load Profile…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding ProfileName}" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmooi.Text}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="{Binding SimConnectStatus}" Foreground="{DynamicResource Icsmooi.TextMuted}" FontSize="12" />
                <TextBlock Text="{Binding EngineStatus}" Foreground="{DynamicResource Icsmooi.TextMuted}" FontSize="12" />

                <Separator Margin="0,4" />

                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding EffectsEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  ToolTip.Tip="Enable real DirectInput hardware output — off by default" />
                    <TextBlock Text="{Binding EffectsStatus}" FontWeight="Bold" VerticalAlignment="Center"
                               Classes.enabled="{Binding EffectsEnabled}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Icsmooi.TextMuted}" />
                            </Style>
                            <Style Selector="TextBlock.enabled">
                                <Setter Property="Foreground" Value="{DynamicResource Icsmooi.Warning}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="Effects stay off until you switch this on — loading a profile and running the engine only ever produces simulated readouts."
                           Foreground="{DynamicResource Icsmooi.TextMuted}" FontSize="10" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>

</Window>
