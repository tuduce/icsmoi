<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="420" d:DesignHeight="260"
        x:Class="icsmooi.Runtime.Views.StatusWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="icsmooi Runtime"
        Width="420" Height="260"
        CanResize="False"
        Background="#1A1A2E">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="icsmooi Runtime" FontSize="18" FontWeight="Bold"
                    Foreground="White" />
        <TextBlock Text="Background telemetry + force-feedback engine."
                    Foreground="#CCCCCC" TextWrapping="Wrap" />
        <TextBlock Text="Status UI (profile, sim connection, active effects) lands in a later phase."
                    Foreground="#888888" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

</Window>
