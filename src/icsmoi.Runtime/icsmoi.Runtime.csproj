<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icsmoi.Shared.Ui\Assets\icsmoi.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\icsmoi.Core\icsmoi.Core.csproj" />
    <ProjectReference Include="..\icsmoi.Shared.Ui\icsmoi.Shared.Ui.csproj" />
    <!-- Build-order only: the Runtime launches the Editor as a separate process (its slots' Edit buttons),
         so the Editor is built first and copied next to it below. Nothing from it is referenced in code. -->
    <ProjectReference Include="..\icsmoi.Editor\icsmoi.Editor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the Editor in <Runtime folder>\Editor so EditorLauncher can always find it. -->
  <Target Name="BundleEditor" AfterTargets="Build">
    <ItemGroup>
      <EditorOutputFiles Include="..\icsmoi.Editor\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorOutputFiles)"
          DestinationFiles="@(EditorOutputFiles->'$(OutDir)Editor\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
