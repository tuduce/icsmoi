<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="icsmooi.App"
             xmlns:local="using:icsmooi"
             RequestedThemeVariant="Dark">
             <!-- icsmooi always uses its own dark navy/slate palette — see icsmooi.Shared.Ui/Styles/Tokens.axaml — rather than following the OS theme. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NodifyM.Avalonia/ResourceDictionaries/Dark.axaml" />
                <ResourceInclude Source="avares://NodifyM.Avalonia/ResourceDictionaries/Brushes.axaml" />
                <ResourceInclude Source="avares://icsmooi.Shared.Ui/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
    </Application.Styles>
</Application>
