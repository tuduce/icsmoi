<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:icsmooi.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="icsmooi.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://icsmooi.Shared.Ui/Assets/icsmooi.ico"
        Title="icsmooi — FFB Profile Editor"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Icsmooi.Background}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://icsmooi.Editor/Views/NodeTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ Top toolbar ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Icsmooi.Surface}" Padding="10,6"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Icsmooi.Border}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Border CornerRadius="{DynamicResource Icsmooi.PillRadius}" Padding="10,3" VerticalAlignment="Center"
                            Background="{DynamicResource Icsmooi.SurfaceAlt}">
                        <TextBlock Text="{Binding SimConnectStatus}"
                                   FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                    </Border>
                    <Button Classes="iconed" Command="{Binding ToggleSimConnectionCommand}"
                            IsVisible="{Binding !SimConnectActive}"
                            ToolTip.Tip="Connect to a running MSFS2020/2024 instance for live telemetry (test-run only — no hardware output in the Editor)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Connect}" />
                            <TextBlock Text="Connect to Sim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding ToggleSimConnectionCommand}"
                            IsVisible="{Binding SimConnectActive}"
                            ToolTip.Tip="Disconnect from the sim">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Disconnect}" />
                            <TextBlock Text="Disconnect Sim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="{DynamicResource Icsmooi.PillRadius}" Padding="10,3" VerticalAlignment="Center"
                            Background="{DynamicResource Icsmooi.SurfaceAlt}">
                        <TextBlock Text="{Binding EngineStatus}"
                                   FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                    </Border>
                    <Button Classes="iconed" Command="{Binding ToggleEngineCommand}"
                            IsVisible="{Binding !EngineRunning}"
                            ToolTip.Tip="Start the evaluation engine (100 Hz)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Play}" />
                            <TextBlock Text="Start Engine" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding ToggleEngineCommand}"
                            IsVisible="{Binding EngineRunning}"
                            ToolTip.Tip="Stop the evaluation engine">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Stop}" />
                            <TextBlock Text="Stop Engine" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="{DynamicResource Icsmooi.PillRadius}" Padding="10,3" VerticalAlignment="Center"
                            Background="{DynamicResource Icsmooi.SurfaceAlt}"
                            IsVisible="{Binding FileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding FileStatus}" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                   FontSize="11" Opacity="0.85" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding FileStatus}" />
                    </Border>
                    <Button Classes="round" Click="OnSaveClicked"
                            ToolTip.Tip="Save profile as… (choose any location)">
                        <ContentControl Theme="{StaticResource Icsmooi.Icon}" Content="{StaticResource Icsmooi.Icon.Save}" />
                    </Button>
                    <Button Classes="round" Click="OnLoadClicked"
                            ToolTip.Tip="Open profile… (choose any location)">
                        <ContentControl Theme="{StaticResource Icsmooi.Icon}" Content="{StaticResource Icsmooi.Icon.Open}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ContentControl Theme="{StaticResource Icsmooi.Wordmark}" Height="22" Margin="2,0,10,0"
                                    VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Margin="0,0,6,0" Background="{DynamicResource Icsmooi.Border}" />
                    <TextBlock Text="Profile:" VerticalAlignment="Center" Opacity="0.7"
                               Foreground="{DynamicResource Icsmooi.Text}" />
                    <TextBox Text="{Binding Profile.ProfileName}"
                             MinWidth="220" Padding="6,3" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Main workspace ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*">

            <!-- ─── Left sidebar: node palette ──────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource Icsmooi.Surface}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Icsmooi.Border}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6" Margin="10">
                    <TextBlock Text="NODE PALETTE" FontSize="11" FontWeight="Bold"
                               Opacity="0.5" LetterSpacing="1" Margin="0,0,0,6" />

                    <TextBlock Text="INPUT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmooi.Category.Input}" LetterSpacing="1" />
                    <Button Classes="iconed" Command="{Binding AddSimConnectNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="MSFS SimConnect variable source">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.SimConnect}" />
                            <TextBlock Text="SimConnect Input" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="LOGIC &amp; MATH" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmooi.Category.MathLogic}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddMathNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="NCalc expression (e.g. [A] * 0.5)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Math}" />
                            <TextBlock Text="Math Compute" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddComparisonNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Compare A and B (&gt;, &lt;, ==, ...)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Compare}" />
                            <TextBlock Text="Compare" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddLogicNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="AND / OR / NOT / XOR">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Logic}" />
                            <TextBlock Text="Logic" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddSelectNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Pick IfTrue or IfFalse based on Condition">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Select}" />
                            <TextBlock Text="Select" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SHAPING" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmooi.Category.Shaping}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddClampNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Clamp Value between Min and Max">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Clamp}" />
                            <TextBlock Text="Clamp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddRangeMapNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Remap Value from one range to another">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.RangeMap}" />
                            <TextBlock Text="Range Map" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddCurveNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Multi-point curve — drag to shape">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Curve}" />
                            <TextBlock Text="Curve" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="HARDWARE OUTPUT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmooi.Category.HardwareOutput}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddConstantForceOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Constant Force effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.ConstantForce}" />
                            <TextBlock Text="Constant Force" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddConditionOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Spring/Damper/Inertia/Friction effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Condition}" />
                            <TextBlock Text="Condition" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddPeriodicOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Sine/Square/Triangle/Sawtooth effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.Periodic}" />
                            <TextBlock Text="Periodic" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddRampForceOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Ramp Force effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmooi.BadgeIcon}" Content="{StaticResource Icsmooi.Icon.RampForce}" />
                            <TextBlock Text="Ramp Force" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,8" />

                    <TextBlock Text="TIPS" FontSize="10" Opacity="0.4" LetterSpacing="1" />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Drag between pins to connect." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Del — delete selected nodes." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Scroll — zoom canvas." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Middle-drag — pan canvas." />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── Right: NodifyM canvas ────────────────────────────────── -->
            <!-- NodifyEditor sizes itself from its *parent's* width (Width = parent width / zoom), so it must be
                 the sole child of its own panel. Placed directly in the grid cell it became as wide as the whole
                 workspace, was centred, and slid ~160px left underneath the sidebar. -->
            <Panel Grid.Column="1" ClipToBounds="True">
                <controls:NodifyEditor
                    x:Name="Editor"
                    ItemsSource="{Binding Nodes}"
                    Connections="{Binding Connections}"
                    PendingConnection="{Binding PendingConnection}"
                    PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                    ConnectionTemplate="{StaticResource ConnectionTemplate}"
                    DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                    ItemTemplate="{StaticResource MainNodeTemplateSelector}"
                    Background="{DynamicResource NodifyEditor.Background}">

                    <controls:NodifyEditor.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
                    </controls:NodifyEditor.KeyBindings>

                </controls:NodifyEditor>
            </Panel>

        </Grid>
    </Grid>
</Window>
