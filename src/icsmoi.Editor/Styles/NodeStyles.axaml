<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia">
  <!--
    Rounded-node override of NodifyM.Avalonia's Node control.

    NodifyM's own template (Maklith/NodifyM.Avalonia, Controls/Node.axaml)
    hard-codes CornerRadius="3" on the outer Border and on the header/footer,
    and hard-codes the selected/hover BorderBrush ("Orange"/"LightBlue"). The
    Template is a plain style Setter, so this file — included after NodifyM's
    ControlStyles.axaml in App.axaml — replaces it with a copy that uses the
    Icsmoi.NodeRadius token and clips its content to the rounded shape. Every
    PART_* thumb and named presenter is kept so the Node control's code still
    finds them. Maintenance cost: NodifyM template changes are no longer
    picked up automatically.

    Editor only: Shared.Ui does not reference NodifyM, and Runtime never
    renders a graph.

    Node headers are tinted per category (HeaderBrush is bound in
    Views/NodeTemplates.axaml), so header text is dark for contrast on the
    light category colors.
  -->

  <Style Selector="controls|Node">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{DynamicResource Icsmoi.NodeRadius}"
                ClipToBounds="True">
          <Grid>
            <Grid.Styles>
              <Style Selector="Thumb">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="IsVisible" Value="False"/>
                <Setter Property="Template">
                  <ControlTemplate>
                    <Grid>
                      <Ellipse Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"
                               Fill="{TemplateBinding Background}" />
                    </Grid>
                  </ControlTemplate>
                </Setter>
              </Style>
            </Grid.Styles>

            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{TemplateBinding HeaderBrush}"
                    CornerRadius="{DynamicResource Icsmoi.NodeHeaderRadius}"
                    Grid.ColumnSpan="3"
                    Padding="10 6 10 6">
              <ContentPresenter Name="HeaderContentPresenter" Content="{TemplateBinding Header}" />
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ItemsControl ItemsSource="{TemplateBinding Input}"
                            Grid.IsSharedSizeScope="True"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                            Focusable="False" />

              <Border Grid.Column="1"
                      Padding="16 4 16 8"
                      Background="{TemplateBinding ContentBrush}">
                <ContentPresenter Content="{TemplateBinding Content}" />
              </Border>

              <ItemsControl ItemsSource="{TemplateBinding Output}"
                            ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            Grid.Column="2"
                            Focusable="False" />
            </Grid>

            <!-- Footer -->
            <Border IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{TemplateBinding FooterBrush}"
                    CornerRadius="{DynamicResource Icsmoi.NodeFooterRadius}"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Padding="10 6 10 6">
              <ContentPresenter Name="FooterContentPresenter" Content="{TemplateBinding Footer}" />
            </Border>

            <!-- Resize handles (unused by icsmoi, kept for NodifyM's template-part lookup) -->
            <Thumb Name="PART_TopLeft" Cursor="TopLeftCorner" Grid.Row="0" Grid.RowSpan="3"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="-6,-6,0,0" Background="{TemplateBinding BorderBrush}" />
            <Thumb Name="PART_TopRight" Cursor="TopRightCorner" Grid.Row="0" Grid.RowSpan="3"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-6,-6,0" Background="{TemplateBinding BorderBrush}" />
            <Thumb Name="PART_BottomLeft" Cursor="BottomLeftCorner" Grid.Row="0" Grid.RowSpan="3"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="-6,0,0,-6" Background="{TemplateBinding BorderBrush}" />
            <Thumb Name="PART_BottomRight" Cursor="BottomRightCorner" Grid.Row="0" Grid.RowSpan="3"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,-6,-6" Background="{TemplateBinding BorderBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Canvas grid: LargeGridLine ignores the GridLinesColor resource and defaults to Gainsboro -->
  <Style Selector="controls|LargeGridLine">
    <Setter Property="Brush" Value="{DynamicResource Icsmoi.GridLines}" />
  </Style>

  <Style Selector="controls|Node ContentPresenter#HeaderContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Icsmoi.Background}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|Node ContentPresenter#FooterContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!--
    Compact numeric field used inside nodes (input-pin constants, axis/gain).
    Fluent's NumericUpDown draws its border (all four sides, ControlCornerRadius)
    on an inner ButtonSpinner (PART_Spinner) whose MinHeight comes from the theme,
    not from the NumericUpDown — so the height has to be reduced on that part.
    Forcing Height/MinHeight on the NumericUpDown alone clips the spinner and
    cuts off its top/bottom border and rounded corners. The inner TextBox keeps
    Fluent's Margin=-1 overlap of that border, so its own MinHeight must stay
    below the spinner's.
  -->
  <Style Selector="NumericUpDown.field">
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="FormatString" Value="0.####" />
    <Setter Property="Increment" Value="0.05" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="26" />
    <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="^ /template/ TextBox#PART_TextBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Style>

  <!-- Hover / selection rings (replace NodifyM's hard-coded LightBlue / Orange) -->
  <Style Selector="controls|Node[IsSelected=False]:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Icsmoi.Category.Input}" />
  </Style>
  <Style Selector="controls|Node[IsSelected=True]">
    <Setter Property="BorderBrush" Value="{DynamicResource Icsmoi.Text}" />
  </Style>

</Styles>
