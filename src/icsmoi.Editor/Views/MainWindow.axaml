<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:icsmoi.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="icsmoi.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://icsmoi.Shared.Ui/Assets/icsmoi.ico"
        Title="icsmoi — FFB Profile Editor"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Icsmoi.Background}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Toolbar status text: muted normally, error color for failed saves/loads -->
        <Style Selector="TextBlock.status">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Icsmoi.Error}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://icsmoi.Editor/Views/NodeTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ Top toolbar ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Icsmoi.Surface}" Padding="10,6"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Icsmoi.Border}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <!-- One status field for every message (sim, engine, file). Fixed width, so a
                         longer/shorter message never moves the buttons; the sim/engine *state*
                         lives in the buttons' icon + tint below. -->
                    <Border Width="240" Height="28" Padding="12,0" VerticalAlignment="Center"
                            CornerRadius="{DynamicResource Icsmoi.PillRadius}"
                            Background="{DynamicResource Icsmoi.SurfaceAlt}">
                        <TextBlock Classes="status" Classes.error="{Binding StatusIsError}"
                                   Text="{Binding StatusMessage}"
                                   FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusMessage}" />
                    </Border>

                    <!-- Sim toggle: the icon flips between connect / disconnect, and the circle turns
                         amber while connecting/retrying and green once SimConnect is really up.
                         Both variants are 36x36 in the same slot, so nothing shifts on click. -->
                    <Panel>
                        <Button Classes="round" Command="{Binding ToggleSimConnectionCommand}"
                                IsVisible="{Binding !SimConnectActive}"
                                ToolTip.Tip="Connect to a running MSFS2020/2024 instance for live telemetry (test-run only — no hardware output in the Editor)">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Connect}" />
                        </Button>
                        <Button Classes="round" Classes.on="{Binding SimConnected}"
                                Classes.pending="{Binding !SimConnected}"
                                Command="{Binding ToggleSimConnectionCommand}"
                                IsVisible="{Binding SimConnectActive}"
                                ToolTip.Tip="Disconnect from the sim (amber = connecting, green = connected)">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Disconnect}" />
                        </Button>
                    </Panel>

                    <!-- Engine toggle: play / stop icon, green while the engine runs. -->
                    <Panel>
                        <Button Classes="round" Command="{Binding ToggleEngineCommand}"
                                IsVisible="{Binding !EngineRunning}"
                                ToolTip.Tip="Start the evaluation engine (100 Hz)">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Play}" />
                        </Button>
                        <Button Classes="round on" Command="{Binding ToggleEngineCommand}"
                                IsVisible="{Binding EngineRunning}"
                                ToolTip.Tip="Stop the evaluation engine (running)">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Stop}" />
                        </Button>
                    </Panel>

                    <Border Width="1" Height="22" Margin="2,0" Background="{DynamicResource Icsmoi.Border}" />

                    <Button Classes="round" Click="OnSaveClicked"
                            ToolTip.Tip="Save profile (asks for a location the first time)">
                        <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Save}" />
                    </Button>
                    <Button Classes="round" Click="OnSaveAsClicked"
                            ToolTip.Tip="Save profile as… (choose any location)">
                        <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.SaveAs}" />
                    </Button>
                    <Button Classes="round" Click="OnLoadClicked"
                            ToolTip.Tip="Open profile… (choose any location)">
                        <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Open}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ContentControl Theme="{StaticResource Icsmoi.Wordmark}" Height="22" Margin="2,0,10,0"
                                    VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Margin="0,0,6,0" Background="{DynamicResource Icsmoi.Border}" />
                    <TextBlock Text="Profile:" VerticalAlignment="Center" Opacity="0.7"
                               Foreground="{DynamicResource Icsmoi.Text}" />

                    <!-- Read mode: the name + a pencil to edit it. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding !IsEditingProfileName}">
                        <TextBlock Text="{Binding Profile.ProfileName}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Profile.ProfileName}" />
                        <Button Classes="round compact" Click="OnEditProfileNameClicked"
                                ToolTip.Tip="Rename profile">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Edit}" />
                        </Button>
                    </StackPanel>

                    <!-- Edit mode: Enter / clicking away / ✓ commits, Esc cancels (see MainWindow.axaml.cs). -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding IsEditingProfileName}">
                        <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileNameDraft}"
                                 Width="200" Padding="8,0" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnProfileNameKeyDown" LostFocus="OnProfileNameLostFocus" />
                        <Button Classes="round compact" Focusable="False"
                                Command="{Binding CommitProfileNameCommand}"
                                ToolTip.Tip="Apply name (Enter) — Esc cancels">
                            <ContentControl Theme="{StaticResource Icsmoi.Icon}" Content="{StaticResource Icsmoi.Icon.Check}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Main workspace ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*">

            <!-- ─── Left sidebar: node palette ──────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource Icsmoi.Surface}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Icsmoi.Border}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6" Margin="10">
                    <TextBlock Text="NODE PALETTE" FontSize="11" FontWeight="Bold"
                               Opacity="0.5" LetterSpacing="1" Margin="0,0,0,6" />

                    <TextBlock Text="INPUT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmoi.Category.Input}" LetterSpacing="1" />
                    <Button Classes="iconed" Command="{Binding AddSimConnectNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="MSFS SimConnect variable source">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.SimConnect}" />
                            <TextBlock Text="SimConnect Input" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="iconed" Command="{Binding AddJoystickInputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Axes, sliders and buttons of any joystick (force feedback not required)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Joystick}" />
                            <TextBlock Text="Joystick Input" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="LOGIC &amp; MATH" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmoi.Category.MathLogic}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddMathNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="NCalc expression (e.g. [A] * 0.5)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Math}" />
                            <TextBlock Text="Math Compute" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddComparisonNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Compare A and B (&gt;, &lt;, ==, ...)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Compare}" />
                            <TextBlock Text="Compare" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddLogicNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="AND / OR / NOT / XOR">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Logic}" />
                            <TextBlock Text="Logic" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddEdgeDetectorNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="One-tick pulse when Input goes low→high, high→low, or either (remembers the previous level)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Edge}" />
                            <TextBlock Text="Edge Detector" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddSelectNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Pick IfTrue or IfFalse based on Condition">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Select}" />
                            <TextBlock Text="Select" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SHAPING" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmoi.Category.Shaping}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddClampNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Clamp Value between Min and Max">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Clamp}" />
                            <TextBlock Text="Clamp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddRangeMapNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Remap Value from one range to another">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.RangeMap}" />
                            <TextBlock Text="Range Map" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddCurveNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Multi-point curve — drag to shape">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Curve}" />
                            <TextBlock Text="Curve" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddIntegratorNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Running total of Input per second — trim, distance travelled (remembers its value)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Integrator}" />
                            <TextBlock Text="Integrator" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="HARDWARE OUTPUT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Icsmoi.Category.HardwareOutput}"
                               LetterSpacing="1" Margin="0,6,0,0" />
                    <Button Classes="iconed" Command="{Binding AddConstantForceOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Constant Force effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.ConstantForce}" />
                            <TextBlock Text="Constant Force" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddConditionOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Spring/Damper/Inertia/Friction effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Condition}" />
                            <TextBlock Text="Condition" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddPeriodicOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Sine/Square/Triangle/Sawtooth effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.Periodic}" />
                            <TextBlock Text="Periodic" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconed" Command="{Binding AddRampForceOutputNodeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Real DirectInput Ramp Force effect (Runtime app only)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Theme="{StaticResource Icsmoi.BadgeIcon}" Content="{StaticResource Icsmoi.Icon.RampForce}" />
                            <TextBlock Text="Ramp Force" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,8" />

                    <TextBlock Text="TIPS" FontSize="10" Opacity="0.4" LetterSpacing="1" />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Drag between pins to connect." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Del — delete selected nodes." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Scroll — zoom canvas." />
                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="Middle-drag — pan canvas." />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── Right: NodifyM canvas ────────────────────────────────── -->
            <!-- NodifyEditor sizes itself from its *parent's* width (Width = parent width / zoom), so it must be
                 the sole child of its own panel. Placed directly in the grid cell it became as wide as the whole
                 workspace, was centred, and slid ~160px left underneath the sidebar. -->
            <Panel Grid.Column="1" ClipToBounds="True">
                <controls:NodifyEditor
                    x:Name="Editor"
                    ItemsSource="{Binding Nodes}"
                    Connections="{Binding Connections}"
                    PendingConnection="{Binding PendingConnection}"
                    PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                    ConnectionTemplate="{StaticResource ConnectionTemplate}"
                    DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                    ItemTemplate="{StaticResource MainNodeTemplateSelector}"
                    Background="{DynamicResource NodifyEditor.Background}">

                    <controls:NodifyEditor.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
                    </controls:NodifyEditor.KeyBindings>

                </controls:NodifyEditor>
            </Panel>

        </Grid>
    </Grid>
</Window>
